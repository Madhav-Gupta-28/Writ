{
  "name": "writ",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "fixtures": "node scripts/gen-fixtures.ts",
    "test:sol": "cd contracts && forge test",
    "test:fork": "cd contracts && forge test --fork-url arc_testnet --match-contract ForkTest -vv",
    "pq-check": "node scripts/pq-check.ts",
    "flow": "node --env-file=.env scripts/flow.ts",
    "rehearse": "node --env-file=.env scripts/rehearse.ts",
    "deploy": "node --env-file=.env scripts/deploy.ts",
    "auth-check": "node --env-file=.env scripts/auth-check.ts",
    "open-order": "node --env-file=.env scripts/open-order.ts",
    "abi": "node scripts/export-abi.ts",
    "web": "npm --prefix web run dev",
    "keeper": "node --env-file=.env scripts/keeper.ts",
    "sync": "node scripts/sync-release.ts"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "viem": "2.57.3"
  }
}
